---
interface Props {
  placement?: "desktop" | "mobile" | "inline";
  class?: string;
}

const adClient = "ca-pub-5392907932829483";
const adSlot = "7015062537";
const { placement = "inline", class: className = "" } = Astro.props;
---

<aside class:list={["google-ad", `google-ad--${placement}`, className]} aria-label="광고">
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client={adClient}
    data-ad-slot={adSlot}
    data-ad-format="auto"
    data-full-width-responsive="true"></ins>
</aside>
<script is:inline>
  (function () {
    const script = document.currentScript;
    const adContainer = script?.previousElementSibling;
    const adUnit = adContainer?.querySelector(".adsbygoogle");

    const initializeAd = function () {
      if (
        !adUnit ||
        adContainer.offsetParent === null ||
        adUnit.dataset.adInitialized === "true"
      ) {
        return;
      }

      adUnit.dataset.adInitialized = "true";
      (window.adsbygoogle = window.adsbygoogle || []).push({});
      window.removeEventListener("resize", initializeAd);
    };

    initializeAd();
    window.addEventListener("resize", initializeAd, { passive: true });
  })();
</script>

<style>
  .google-ad {
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    padding: 1rem;
    min-height: 120px;
  }

  .google-ad--inline {
    margin: 2rem 0 2.5rem;
  }

  @media (min-width: 769px) {
    .google-ad--mobile {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .google-ad--desktop {
      display: none;
    }
  }
</style>
