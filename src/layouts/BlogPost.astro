---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import CustomHeadScripts from "../components/CustomHeadScripts.astro";
import CustomBodyScripts from "../components/CustomBodyScripts.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import GoogleAdSenseDisplay from "../components/GoogleAdSenseDisplay.astro";
import { Image } from "astro:assets";
import { SITE_TITLE } from "../consts";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, tags } =
  Astro.props;
const pageTitle = title + " | " + SITE_TITLE;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = heroImage
  ? new URL(heroImage.src, Astro.site).href
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(ogImage && { image: ogImage }),
  author: { "@type": "Person", name: "곽용준" },
  publisher: { "@type": "Organization", name: SITE_TITLE },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL.href },
};
---

<html lang="ko">
  <head>
    <BaseHead
      title={pageTitle}
      description={description}
      image={heroImage}
      type="article"
      publishedDate={pubDate}
      updatedDate={updatedDate}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
    <CustomHeadScripts />
    <style>
      #post-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        width: 0;
        background: var(--accent);
        transition:
          width 0.1s linear,
          background-color 0.2s ease;
        z-index: 9999;
      }

      main {
        width: 100%;
        max-width: 100%;
        padding-top: 2rem;
      }

      .hero-image {
        width: min(1020px, calc(100% - 40px));
        margin: 0 auto;
      }

      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 1rem;
        box-shadow: var(--hero-shadow);
      }

      .post-layout {
        display: grid;
        grid-template-columns:
          minmax(120px, 180px)
          minmax(0, 720px)
          minmax(120px, 180px);
        gap: 2rem;
        align-items: start;
        justify-content: center;
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
      }

      :global(.post-side-ad) {
        position: sticky;
        top: 5rem;
        margin-top: 1.5rem;
        min-height: 280px;
      }

      :global(.post-mobile-ad) {
        margin: 2rem 0;
      }

      .prose {
        width: 100%;
        max-width: 720px;
        margin: 0 auto;
        padding: 1.5rem 20px;
        color: var(--text);
      }

      .title {
        margin-bottom: 1em;
        padding: 1.5rem 0 1rem;
        line-height: 1;
      }

      .title h1 {
        margin: 0 0 0.5em 0;
        font-size: 2rem;
        line-height: 1.25;
        letter-spacing: -0.02em;
      }

      .date {
        margin-bottom: 0.5em;
        color: var(--text-muted);
      }

      .last-updated-on {
        font-style: italic;
      }

      .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 1rem 0 0.5rem;
      }

      .post-tag {
        padding: 0.3rem 0.8rem;
        border-radius: 9999px;
        background-color: var(--surface-container);
        color: var(--text-muted);
        font-size: 0.8rem;
        font-weight: 500;
        text-decoration: none;
        transition:
          background-color 0.2s ease,
          color 0.2s ease;
      }

      .post-tag:hover {
        background-color: var(--accent-container);
        color: var(--on-accent-container);
      }

      @media (max-width: 768px) {
        main {
          padding-top: 1.5rem;
        }

        .post-layout {
          display: block;
          width: 100%;
        }

        .prose {
          max-width: calc(100% - 40px);
          padding: 1.25rem 20px;
        }

        .title {
          padding-top: 1rem;
        }

        .title h1 {
          font-size: 1.6rem;
          line-height: 1.3;
          letter-spacing: -0.01em;
        }
      }
    </style>
  </head>

  <body>
    <CustomBodyScripts />
    <div id="post-progress" aria-hidden="true"></div>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <Image width={1020} height={510} src={heroImage} alt="" />
            )
          }
        </div>
        <div class="post-layout">
          <GoogleAdSenseDisplay placement="desktop" class="post-side-ad" />
          <div class="prose">
            <div class="title">
              <div class="date">
                <FormattedDate date={pubDate} />
                {
                  updatedDate && (
                    <div class="last-updated-on">
                      Last updated on <FormattedDate date={updatedDate} />
                    </div>
                  )
                }
              </div>
              <h1>{title}</h1>
              {
                tags && tags.length > 0 && (
                  <div class="post-tags">
                    {tags.map((tag) => (
                      <a
                        class="post-tag"
                        href={`/tags/${encodeURIComponent(tag)}/`}
                      >
                        #{tag}
                      </a>
                    ))}
                  </div>
                )
              }
              <hr />
            </div>
            <GoogleAdSenseDisplay placement="mobile" class="post-mobile-ad" />
            <slot />
            <GoogleAdSenseDisplay placement="mobile" class="post-mobile-ad" />
          </div>
          <GoogleAdSenseDisplay placement="desktop" class="post-side-ad" />
        </div>
      </article>
    </main>
    <Footer />
    <script is:inline>
      const progressBar = document.querySelector("#post-progress");

      const updateProgress = () => {
        if (!progressBar) return;
        const scrollTop =
          document.documentElement.scrollTop || document.body.scrollTop;
        const scrollHeight =
          document.documentElement.scrollHeight -
          document.documentElement.clientHeight;

        if (scrollHeight <= 0) {
          progressBar.style.width = "0%";
          return;
        }

        const progress = Math.min(
          100,
          Math.max(0, (scrollTop / scrollHeight) * 100),
        );
        progressBar.style.width = `${progress}%`;
      };

      updateProgress();
      window.addEventListener("scroll", updateProgress, { passive: true });
      window.addEventListener("resize", updateProgress);
    </script>
  </body>
</html>
